FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim
RUN uv venv /opt/mcp && uv pip install --python /opt/mcp/bin/python 'mcp==2.0.0' 'httpx==0.28.1'
COPY deploy/agents/install_kubectl.py /opt/bridge/install_kubectl.py
RUN uv run --no-project --no-sync /opt/bridge/install_kubectl.py
COPY deploy/agents/mcp_proxy.py deploy/agents/entrypoint.py /opt/bridge/
ENV ENVFORGE_AGENT=kubectl_ai UV_CACHE_DIR=/tmp/uv UV_NO_SYNC=1 UV_NO_MANAGED_PYTHON=1
USER 10001:10001
ENTRYPOINT ["uv", "run", "--no-project", "--no-sync", "--python", "/opt/mcp/bin/python", "python", "/opt/bridge/entrypoint.py"]
